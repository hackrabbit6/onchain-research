# ── Token holder clustering (EVM/BSC) ───────────────────────────────
# Recommended free live-data provider.
MORALIS_API_KEY=
# Optional fallback provider.
ETHERSCAN_API_KEY=
# Optional: make live data the default provider (otherwise fixture data).
# CLUSTER_PROVIDER=moralis

# ── Wallet tracking (EVM/BSC) ───────────────────────────────────────
# Optional provider key. Leave blank for offline/local analysis.
ETHEREUM_RPC_URL=
# Local paths can be overridden if needed.
WALLET_TRACKER_DATA_DIR=./data
WALLET_TRACKER_EXPORT_DIR=./exports
